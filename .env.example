# 至少需要配置一个模型提供商的 API Key

# Anthropic (Claude)
ANTHROPIC_API_KEY=

# OpenAI (GPT)
OPENAI_API_KEY=

# Google (Gemini)
GOOGLE_GENERATIVE_AI_API_KEY=

# xAI (Grok)
XAI_API_KEY=

# DeepSeek
DEEPSEEK_API_KEY=

# Alibaba Qwen (通义千问)
ALIBABA_API_KEY=

# Zhipu AI (智谱 GLM)
ZHIPU_API_KEY=

# Moonshot AI (Kimi)
MOONSHOT_API_KEY=
# 可选：Moonshot 按区域分两套平台，Key 与端点绑定、不能混用。
#   国际 platform.moonshot.ai  → 端点 api.moonshot.ai（SDK 默认，无需设置）
#   国内 platform.moonshot.cn / platform.kimi.com → 端点 api.moonshot.cn
# 用国内平台申请的 Key 时，取消下一行注释；否则会报 Invalid Authentication(401)。
# MOONSHOT_BASE_URL=https://api.moonshot.cn/v1

# 自定义 OpenAI 兼容提供商
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_MODEL=

# 默认模型 (可选，如 deepseek:deepseek-v4-flash)
X_CODE_MODEL=

# Tavily 搜索 (可选，免费 1000 次/月，https://tavily.com)
TAVILY_API_KEY=
